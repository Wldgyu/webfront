#include <stdio.h>
#include <stdlib.h> // malloc, free, abs 함수

// 사각형의 두 꼭짓점 좌표를 묶은 구조체
struct Rect {
    int x1, y1;
    int x2, y2;
};

int main()
{
    // 구조체 포인터 선언 및 동적 메모리 할당
    struct Rect *r = malloc(sizeof(struct Rect));

    // 좌표 하드코딩 
    r->x1 = 10;
    r->y1 = 20;
    r->x2 = 50;
    r->y2 = 60;

    // abs() 절댓값 함수를 이용해 가로, 세로 길이 구하기
    int width = abs(r->x2 - r->x1);   // |50 - 10| = 40
    int height = abs(r->y2 - r->y1);  // |60 - 20| = 40

    int area = width * height;        

    printf("가로: %d, 세로: %d\n", width, height);
    printf("사각형의 넓이: %d\n", area);

    // 동적 할당한 메모리 해제
    free(r);

    return 0;
}